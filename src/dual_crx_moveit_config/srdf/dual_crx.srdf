<?xml version="1.0" encoding="UTF-8"?>
<robot name="dual_crx">
  <group name="left_arm">
    <chain base_link="left_base_link" tip_link="left_flange"/>
  </group>

  <group name="right_arm">
    <chain base_link="right_base_link" tip_link="right_flange"/>
  </group>

  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>

  <group name="left_tool0">
    <link name="left_flange"/>
  </group>
  <group name="right_tool0">
    <link name="right_flange"/>
  </group>

  <group_state name="home" group="left_arm">
    <joint name="left_J1" value="0.0"/>
    <joint name="left_J2" value="0.0"/>
    <joint name="left_J3" value="0.0"/>
    <joint name="left_J4" value="0.0"/>
    <joint name="left_J5" value="-1.5707963267948966"/>
    <joint name="left_J6" value="0.0"/>
  </group_state>

  <group_state name="home" group="right_arm">
    <joint name="right_J1" value="-1.5707963267948966"/>
    <joint name="right_J2" value="0.0"/>
    <joint name="right_J3" value="3.141592653589793"/>
    <joint name="right_J4" value="0.0"/>
    <joint name="right_J5" value="1.5707963267948966"/>
    <joint name="right_J6" value="0.0"/>
  </group_state>

  <group_state name="home" group="both_arms">
    <joint name="left_J1" value="0.0"/>
    <joint name="left_J2" value="0.0"/>
    <joint name="left_J3" value="0.0"/>
    <joint name="left_J4" value="0.0"/>
    <joint name="left_J5" value="-1.5707963267948966"/>
    <joint name="left_J6" value="0.0"/>
    <joint name="right_J1" value="-1.5707963267948966"/>
    <joint name="right_J2" value="0.0"/>
    <joint name="right_J3" value="3.141592653589793"/>
    <joint name="right_J4" value="0.0"/>
    <joint name="right_J5" value="1.5707963267948966"/>
    <joint name="right_J6" value="0.0"/>
  </group_state>

  <end_effector name="left_tool0" parent_link="left_flange" group="left_arm"/>
  <end_effector name="right_tool0" parent_link="right_flange" group="right_arm"/>

  <virtual_joint name="left_world_joint" type="fixed" parent_frame="table_frame" child_link="left_base_link"/>
  <virtual_joint name="right_world_joint" type="fixed" parent_frame="table_frame" child_link="right_base_link"/>

  <disable_collisions link1="left_J1_link" link2="left_J2_link" reason="Adjacent"/>
  <disable_collisions link1="left_J1_link" link2="left_J3_link" reason="Never"/>
  <disable_collisions link1="left_J1_link" link2="left_base_link" reason="Adjacent"/>
  <disable_collisions link1="left_J2_link" link2="left_J3_link" reason="Adjacent"/>
  <disable_collisions link1="left_J2_link" link2="left_J4_link" reason="Never"/>
  <disable_collisions link1="left_J3_link" link2="left_J4_link" reason="Adjacent"/>
  <disable_collisions link1="left_J3_link" link2="left_J5_link" reason="Never"/>
  <disable_collisions link1="left_J3_link" link2="left_J6_link" reason="Never"/>
  <disable_collisions link1="left_J3_link" link2="left_base_link" reason="Never"/>
  <disable_collisions link1="left_J4_link" link2="left_J5_link" reason="Adjacent"/>
  <disable_collisions link1="left_J4_link" link2="left_J6_link" reason="Never"/>
  <disable_collisions link1="left_J5_link" link2="left_J6_link" reason="Adjacent"/>
  <disable_collisions link1="left_J5_link" link2="left_ee_mount" reason="Adjacent"/>
  <disable_collisions link1="left_J6_link" link2="left_ee_mount" reason="Adjacent"/>
  <disable_collisions link1="left_flange" link2="left_ee_mount" reason="Adjacent"/>

  <disable_collisions link1="right_J1_link" link2="right_J2_link" reason="Adjacent"/>
  <disable_collisions link1="right_J1_link" link2="right_J3_link" reason="Never"/>
  <disable_collisions link1="right_J1_link" link2="right_base_link" reason="Adjacent"/>
  <disable_collisions link1="right_J2_link" link2="right_J3_link" reason="Adjacent"/>
  <disable_collisions link1="right_J2_link" link2="right_J4_link" reason="Never"/>
  <disable_collisions link1="right_J3_link" link2="right_J4_link" reason="Adjacent"/>
  <disable_collisions link1="right_J3_link" link2="right_J5_link" reason="Never"/>
  <disable_collisions link1="right_J3_link" link2="right_J6_link" reason="Never"/>
  <disable_collisions link1="right_J3_link" link2="right_base_link" reason="Never"/>
  <disable_collisions link1="right_J4_link" link2="right_J5_link" reason="Adjacent"/>
  <disable_collisions link1="right_J4_link" link2="right_J6_link" reason="Never"/>
  <disable_collisions link1="right_J5_link" link2="right_J6_link" reason="Adjacent"/>
  <disable_collisions link1="right_J5_link" link2="right_ee_mount" reason="Adjacent"/>
  <disable_collisions link1="right_J6_link" link2="right_ee_mount" reason="Adjacent"/>
  <disable_collisions link1="right_flange" link2="right_ee_mount" reason="Adjacent"/>
</robot>
